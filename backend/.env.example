# Nebius Token Factory Configuration (https://tokenfactory.nebius.com)
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Gateway Security & Tokens (token must be >= 24 printable ASCII chars)
MAA_DEVICE_TOKENS={"poco":"your-device-token"}
PORT=8080
